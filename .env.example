APP_NAME=SignalHound
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://signalhound:signalhound@postgres:5432/signalhound
REDIS_URL=redis://redis:6379/0
SCANNER_EXECUTION_ENABLED=false
SCANNER_TIMEOUT_SECONDS=300
CORS_ORIGINS=http://localhost:8011
MAX_REQUEST_BODY_BYTES=1048576
CELERY_WORKER_CONCURRENCY=1
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=840
AMASS_VERSION=5.1.1
NUCLEI_VERSION=3.11.1

# Passive public NVD / FIRST EPSS / CISA KEV lookups (no target scanning)
INTELLIGENCE_ENABLED=false

# Bounded TCP segmentation checks; authorize backend source IP / scope IDs / ports first.
# See docs/epic-15-segmentation.md. Neither gate is enabled automatically.
SEGMENTATION_EXECUTION_ENABLED=false
SEGMENTATION_SOURCES_JSON=[]

# Distributed nodes require TLS and independent server/client execution gates.
NODE_EXECUTION_ENABLED=false
NODE_ALLOW_INSECURE_LOOPBACK=false
